# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/

# ---- Dữ liệu: KHÔNG đẩy lên repo public ----
# Giữ cấu trúc thư mục (qua .gitkeep) nhưng bỏ nội dung.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vectordb/
data/qa/train.jsonl
# LoRA adapter / model đã fine-tune (tái tạo được bằng train_qlora.py)
models/
# Nội dung Q/A thật của trường: KHÔNG đẩy lên repo public; chỉ giữ template
data/qa/*.docx
data/qa/*.csv
!data/qa/qa_pairs_template.csv
# Bản sao lưu Q/A trước khi tinh chỉnh câu chữ — vẫn là dữ liệu thật của trường
data/qa/sao-luu/

# Hệ điều hành / IDE
.DS_Store
.vscode/
*.log

# Thư mục tạm của Gradio khi chạy web (xem GRADIO_TEMP_DIR trong chay-web.sh)
.gradio_tmp/
