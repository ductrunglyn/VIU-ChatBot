# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/

# ---- Dữ liệu: KHÔNG đẩy lên repo public ----
# Giữ cấu trúc thư mục (qua .gitkeep) nhưng bỏ nội dung.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vectordb/
data/qa/train.jsonl
# LoRA adapter / model đã fine-tune (tái tạo được bằng train_qlora.py)
models/
# Nội dung Q/A thật của trường: KHÔNG đẩy lên repo public; chỉ giữ template
data/qa/*.docx
data/qa/*.csv
!data/qa/qa_pairs_template.csv
# Mốc tiến độ của mẻ tinh chỉnh: chỉ là danh sách id, nhưng vẫn là dấu vết dữ
# liệu thật và tái tạo được bằng khoi_phuc_tien_do.py
data/qa/*.tien_do.json
# Script một mạch do tinh-chinh.sh sinh ra lúc chạy
.tinh-chinh-mot-mach.sh

# Hệ điều hành / IDE
.DS_Store
.vscode/
*.log
